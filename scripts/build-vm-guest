#!/usr/bin/env bash
# Builds the guest disk image for one program launched "as virtual" (see
# src/shell/vm.rs) and prints the config.toml section that points the
# compositor at it. A VM runs exactly one program, so every program gets its
# own image: run this once per program.
#
#   build-vm-guest <desktop entry id> <nixpkgs package>...
#   build-vm-guest Alacritty alacritty
#
# The image is a minimal NixOS (nix/vm-guest.nix) with sshd, waypipe and the
# given packages. It is built for key login only, using a dedicated key pair
# created on first run. (On NixOS, `services.ironland-compositor.vm.programs`
# builds these images with the system instead.)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ "$#" -lt 2 ]; then
  echo "usage: build-vm-guest <desktop entry id> <nixpkgs package>..." >&2
  exit 2
fi
entry="${1%.desktop}"
shift

dir="${IRONLAND_VM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ironland-compositor/vm}"
key="$dir/id_ed25519"
image="$dir/$entry.qcow2"
mkdir -p "$dir"

if [ ! -f "$key" ]; then
  ssh-keygen -q -t ed25519 -N '' -C ironland-vm-guest -f "$key"
  echo "Created ssh key $key"
fi

export IRONLAND_VM_SSH_PUBKEY IRONLAND_VM_PACKAGES
IRONLAND_VM_SSH_PUBKEY="$(cat "$key.pub")"
IRONLAND_VM_PACKAGES="$*"

out="$(mktemp -d)/guest"
nix build --impure .#nixosConfigurations.vm-guest.config.system.build.images.qemu -o "$out"

built=("$out"/*.qcow2)
install -m 644 "${built[0]}" "$image"

cat <<TOML

Guest image for $entry written to $image. Add this to the compositor's config.toml:

[vm]
ssh_key = "$key"

[vm.programs]
"$entry" = "$image"
TOML
